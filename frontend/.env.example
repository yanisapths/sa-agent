NEXT_PUBLIC_AGENT_API=http://localhost:5001
NEXT_PUBLIC_VAULT_TOKEN=xxx
# Groundwork docs site root, for the Get started guide links. Omit to hide them.
# If this used to point at a Confluence space, move that URL to
# CONFLUENCE_SITE_URL in backend/.env: the sidebar link is now per product.
# NEXT_PUBLIC_DOCS_URL=https://docs.example.com
## Never put a database URL or token in a NEXT_PUBLIC_ variable: every one is
## shipped to the browser. Per-product connections are entered in the app.
