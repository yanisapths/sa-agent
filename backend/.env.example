## Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

BIFROST_BASE_URL=https://xxx-bifrost.xx.example.com
BIFROST_API_KEY=
BIFROST_AUTH_HEADER=x-bf-vk
BIFROST_MODEL=dashscope/qwen3.7-flash
BIFROST_USER_AGENT=sa-agent/0.1
BIFROST_MAX_TOKENS=50000

## Agent models. `provider/model` goes through Bifrost, `provider:model` goes
## direct. Default is BIFROST_MODEL when the gateway is on, else haiku.
# AGENT_CHAT_MODEL=dashscope/qwen3.7-flash
# AGENT_EXECUTE_MODEL=ollama:qwen2.5-coder

## PVT prep track. pvt-execute writes production SQL someone else runs, so it
## is the one phase usually worth a stronger model than the rest.
# AGENT_PVT_DISCUSS_MODEL=dashscope/qwen3.7-flash
# AGENT_PVT_PLAN_MODEL=dashscope/qwen3.7-flash
# AGENT_PVT_EXECUTE_MODEL=dashscope/qwen3.7-flash

## Only needed when a model id is `anthropic:…`
ANTHROPIC_API_KEY=

## Live application database — the agent's source of truth for schema
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_SCHEMA=public

## Chroma Cloud (RAG vector store)
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_API_COLLECTION=aster-system
CHROMA_DDL_COLLECTION=aster-database_ddl

## Embeddings (local Ollama). Width must match the Chroma collection:
## nomic-embed-text = 768, mxbai-embed-large = 1024.
OLLAMA_EMBED_MODEL=mxbai-embed-large
# OLLAMA_EMBED_DIMENSION=1024
OLLAMA_URL=http://localhost:11434

## Supabase (vault storage + metadata)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VAULT_BUCKET=vault
VAULT_STORAGE_FOLDER=vault
VAULT_DEFAULT_USER_ID=user_1
VAULT_DEV_TOKEN=

## Confluence ingestion — either username + access token, or a PAT
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_USERNAME=
CONFLUENCE_ACCESS_TOKEN=
CONFLUENCE_PAT=

## Jira MCP (optional). Local stdio uses Jira REST; omit JIRA_* to reuse
## the Confluence Cloud site + token above. Do not set JIRA_MCP_URL unless
## you have a working remote MCP token (hosted Atlassian MCP needs OAuth).
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PERSONAL_TOKEN=
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
JIRA_MCP_TRANSPORT=http
JIRA_SSL_VERIFY=true

## LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sa-agent
