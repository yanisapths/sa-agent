    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.1",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.49.1",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "cheerio": "^1.2.0",
    "chromadb": "^3.4.3",
    "cors": "^2.8.5",
    "deepagents": "^1.10.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "html-to-text": "^9.0.5",
    "langchain": "^1.4.0",
    "langsmith": "0.9.0",
    "multer": "^1.4.5-lts.1",
