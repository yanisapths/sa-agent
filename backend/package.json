    "mcp:knowledge": "bun run mcp/server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
