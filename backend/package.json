{
  "name": "sa-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "express.ts",
  "scripts": {
    "dev": "bun run express.ts",
    "test": "bun test",
    "eval": "vitest run --config ls.vitest.config.ts",
    "eval:harbor": "harbor run --config agents/evaluators/harbor-job.json -p agents/evaluators/tasks --plugin langsmith --yes",
    "eval:harbor:langsmith": "harbor run --config agents/evaluators/harbor-job.json -p agents/evaluators/tasks --env langsmith --plugin langsmith --yes",
    "typecheck": "tsc --noEmit",
    "doctor": "bun run scripts/doctor.ts",
    "help": "bun run scripts/help.ts",
    "check:bifrost": "bun run scripts/check-bifrost.ts",
    "claude": "bash scripts/claude",
    "tokens": "bun run scripts/token-probe.ts",
    "ingest:confluence": "bun run agents/ingest/confluence.ts",
    "ingest:ddl": "bun run agents/ingest/ddl.ts",
    "ingest:url": "bun run agents/ingest/url.ts",
    "ingest:clear": "bun run agents/ingest/clear.ts",
    "model:build": "bun run agents/model/build.ts",
    "mcp:jira": "bun run mcp/jira.ts",
    "mcp:confluence": "bun run mcp/confluence.ts",
    "mcp:knowledge": "bun run mcp/server.ts",
    "surfaces": "bun run scripts/surfaces.ts write",
    "check:surfaces": "bun run scripts/surfaces.ts check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@langchain/anthropic": "^1.6.6",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/mistralai": "^1.2.1",
    "@langchain/ollama": "^1.3.1",
    "@langchain/openai": "^1.8.5",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.12",
    "cheerio": "^1.2.0",
    "chromadb": "^3.5.0",
    "cors": "^2.8.6",
    "deepagents": "^1.17.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "html-to-text": "^9.0.5",
    "langchain": "^1.6.8",
    "langsmith": "0.9.0",
    "multer": "^1.4.5-lts.2",
    "node-sql-parser": "5.4.0",
    "openai": "^4.104.0",
    "pg": "^8.23.1",
    "pgsql-ast-parser": "^12.0.2",
    "tsx": "^4.23.15",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
