{"nodes": [{"id": "frontend_frontend_convetions_frontend_conventions", "label": "Frontend Conventions", "file_type": "document", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses must/should/may requirement levels and applies only to new or materially changed code, so existing code is not rewritten just to match the guide."}, {"id": "frontend_frontend_convetions_project_stack", "label": "Current Project Stack", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js 15 App Router, React 18, strict TS, static export, Bun, Tailwind 3 + Aster/HeroUI, TanStack Query, RHF+Zod, Zustand, Sentry. Adding a second library for an existing stack responsibility requires an architecture discussion."}, {"id": "frontend_frontend_convetions_static_export_constraint", "label": "Static Export Constraint", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because output is \"export\", Route Handlers, Server Actions, server-only rendering assumptions, and Next image optimization are unavailable without changing the deployment architecture."}, {"id": "frontend_frontend_convetions_feature_folder_structure", "label": "Feature-Based Folder Structure", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route files stay thin and compose feature modules; each feature owns its components, hooks, form.ts, service.ts, and types.ts so a capability has one clear domain owner."}, {"id": "frontend_frontend_convetions_naming_conventions", "label": "Naming and File Conventions", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "handle... for local handlers vs on... for callback props, boolean names that read as a question, and one domain term reused across routes, UI, types, API functions, and tests."}, {"id": "frontend_frontend_convetions_prettier_authority", "label": "Prettier As Formatting Authority", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated tools settle formatting so style is never debated in review; tabs, no semicolons, single quotes, 120 cols, sorted imports and sorted Tailwind classes including inside tv."}, {"id": "frontend_frontend_convetions_typescript_strict_conventions", "label": "TypeScript Strict Conventions", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No any, no @ts-ignore (only @ts-expect-error with a reason), no non-null assertions - the aim is to make invalid states difficult to represent."}, {"id": "frontend_frontend_convetions_client_boundary_policy", "label": "Server/Client Boundary Policy", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'use client' is added only when state, effects, handlers, browser APIs, or client providers are used, and boundaries stay as low as practical to reduce shipped JavaScript."}, {"id": "frontend_frontend_convetions_effects_policy", "label": "Effects Usage Policy", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useEffect only synchronizes React with an external system - not for derived values, user actions, state resets, or fetching already handled by TanStack Query; effects must clean up and must not be async themselves."}, {"id": "frontend_frontend_convetions_memoization_policy", "label": "Memoization Policy", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memoization has maintenance and runtime cost, so useCallback/useMemo/memo are applied only on profiling evidence or a genuine stable-reference requirement."}, {"id": "frontend_frontend_convetions_service_layer", "label": "Frontend Service Layer", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoint functions own URL construction and transport but never render UI, toast, navigate, or set component state; backend errors are normalized at the service/query boundary and unstable responses validated with Zod."}, {"id": "frontend_frontend_convetions_tanstack_query_conventions", "label": "TanStack Query Conventions", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stable array query keys that include every parameter, feature-level key factories, narrowest invalidation after a mutation, and no copying query data into local state - the cache stays the single owner of remote state."}, {"id": "frontend_frontend_convetions_forms_rhf_zod", "label": "Forms With React Hook Form and Zod", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema, inferred type via z.infer, defaults, and the form hook live together in form.ts; an explicit toAPIData mapper converts form values to API input so validation stays UI-independent."}, {"id": "frontend_frontend_convetions_state_ownership_hierarchy", "label": "State Ownership Hierarchy", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven-step ladder from derived value up to a Zustand store - always pick the narrowest owner, and never park query responses or secrets in a store."}, {"id": "frontend_frontend_convetions_aster_design_system", "label": "Aster Design System Priority", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-step component priority ending in a custom accessible component; Flowbite, MUI, and Emotion are legacy and migrated opportunistically rather than expanded."}, {"id": "frontend_frontend_convetions_tailwind_tokens", "label": "Tailwind and Design Tokens", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arbitrary values are avoided when a token exists, and dynamic class fragments are banned because Tailwind cannot statically detect them."}, {"id": "frontend_frontend_convetions_accessibility_requirements", "label": "Accessibility Requirements", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessibility is a release requirement, not follow-up work; lint rules cannot prove it so the actual interaction must be reviewed and tested."}, {"id": "frontend_frontend_convetions_performance_practices", "label": "Performance Practices", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimize only with measured evidence - React DevTools, browser tools, or ANALYZE=true bun run build:nonprd - never speculatively."}, {"id": "frontend_frontend_convetions_bundle_optimization", "label": "JavaScript Bundle Optimization", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hidden component still executes hooks, fetches, and loads dependencies, so display:none / inactive tabs / closed modals must be split or conditionally mounted rather than assumed free."}, {"id": "frontend_frontend_convetions_error_handling_observability", "label": "Error Handling and Observability", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users get plain-language messages while the original error is preserved for Sentry; production console output is stripped so console logging is not an observability strategy."}, {"id": "frontend_frontend_convetions_env_var_security", "label": "Environment Variables and Security", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every NEXT_PUBLIC_ value is assumed visible to users, so no secret or privileged token may live in frontend env files; config is read through a typed src/config/env.ts helper and validated early."}, {"id": "frontend_frontend_convetions_conventional_commits", "label": "Conventional Commits Convention", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commitlint, Commitizen, and Husky are not configured, so Conventional Commits remain a team convention rather than an automatically enforced rule."}, {"id": "frontend_frontend_convetions_precommit_framework", "label": "Python pre-commit Framework", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used instead of Husky for trailing whitespace, private-key detection, and ESLint; the configured pre-push script performs no checks so it must not be treated as a quality gate."}, {"id": "frontend_frontend_convetions_ci_quality_gates", "label": "CI Quality Gates", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitLab CI includes an externally maintained aster-web pipeline, so the full job list is invisible from this repo and required-check changes must be coordinated with that pipeline."}, {"id": "frontend_frontend_convetions_definition_of_done", "label": "Definition of Done Checklist", "file_type": "concept", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frontend_frontend_convetions_package_manager_ambiguity", "label": "Bun vs Yarn packageManager Ambiguity", "file_type": "rationale", "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "package.json declares Yarn in packageManager while README and active scripts use Bun; Bun is the team convention and the metadata should be aligned separately to avoid ambiguous tooling."}], "edges": [{"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_project_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "weight": 1.0}, {"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_feature_folder_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "weight": 1.0}, {"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_naming_conventions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "weight": 1.0}, {"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_prettier_authority", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "weight": 1.0}, {"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_typescript_strict_conventions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "weight": 1.0}, {"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_client_boundary_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/FRONTEND_CONVETIONS.md", "source_location": null, "weight": 1.0}, {"source": "frontend_frontend_convetions_frontend_conventions", "target": "frontend_frontend_convetions_effects_policy", "relation": "references", "confidence": "EXTRACTED", "confi