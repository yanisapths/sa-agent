{"nodes": [{"id": "readme_sa_agent", "label": "sa-agent Capability Provider", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packaged as a provider checkout kept at a stable path so multiple product repos can point at one installation instead of vendoring the tooling per repo."}, {"id": "readme_claude_code_runtime", "label": "Claude Code Runtime", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen when the analyst/architect must write specs and SQL directly into the product repo tree; gets skills, subagents and MCP tools."}, {"id": "readme_codex_runtime", "label": "Codex Runtime", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Has no plugin equivalent of Claude Code subagents, so agents/*.md is not loaded; phase discipline must come from skills and memory/AGENTS.md instead."}, {"id": "readme_chat_gui_runtime", "label": "Chat GUI Runtime", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser chat over HTTP that deliberately does not edit a product workspace - it emits JSON artifacts only."}, {"id": "readme_langchain_deep_agent", "label": "LangChain Deep Agent", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_chat_endpoint", "label": "POST /chat Endpoint", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stateful across turns via a returned threadId that the caller must echo back on later turns."}, {"id": "readme_plugin_marketplace", "label": "sa-agent Plugin Marketplace", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two manifests (.claude-plugin/marketplace.json and .agents/plugins/marketplace.json) point at one plugin so both runtimes load identical skills, MCP servers, and memory."}, {"id": "readme_sa_knowledge_mcp", "label": "sa-knowledge MCP Server", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spawned MCP processes always load backend/.env by absolute path so tools keep working when cwd is a foreign product repo."}, {"id": "readme_jira_mcp", "label": "jira MCP Server", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sa_agent_home", "label": "SA_AGENT_HOME Resolution", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Codex spawns plugin MCP servers with a stripped environment and passes arguments verbatim, so the env var alone cannot locate the checkout; ~/.sa-agent/home is the fallback file the launcher reads."}, {"id": "readme_grounding_hierarchy", "label": "Grounding Hierarchy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered live DB first, indexed knowledge second, Jira only on explicit request - so answers are grounded in the schema that actually ships rather than in ticket prose."}, {"id": "readme_phase_discipline", "label": "One Phase At A Time Discipline", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each artifact must be approved before the next phase runs, preventing the agent from coding against an unvalidated spec."}, {"id": "readme_ingestion_pipeline", "label": "Knowledge Ingestion Pipeline", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "search_api_specs and search_schema_docs are useless until Confluence pages and DDL are indexed, so ingestion is a documented prerequisite."}, {"id": "readme_bifrost_gateway", "label": "Bifrost LLM Gateway", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes every phase through the company gateway; ANTHROPIC_API_KEY is only needed when a model id is anthropic:\u2026 and is unused with the gateway."}, {"id": "readme_port_alignment", "label": "Backend/Frontend Port and CORS Alignment", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next and Express both default near 3000, so PORT and CORS_ORIGIN must be set explicitly to avoid a collision."}, {"id": "readme_list_tables", "label": "list_tables", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_describe_tables", "label": "describe_tables", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_inspect_relationships", "label": "inspect_relationships", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url